{
  "name": "@relativelyunknown/tree-sitter-sql-extended",
  "version": "1.0.0",
  "description": "Tree-sitter SQL grammar: ANSI base plus 22 independently compiled dialect extensions (PostgreSQL, MySQL, MariaDB, Oracle, Db2, T-SQL, BigQuery, Snowflake, Redshift, Databricks, Spark, Hive, DuckDB, SQLite, Trino, Athena, ClickHouse, Flink, CockroachDB, Spanner, Teradata, SAP HANA)",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "install": "node scripts/generate.js && node-gyp-build",
    "generate": "node scripts/generate.js",
    "generate:databricks": "node scripts/generate.js databricks",
    "generate:spark": "node scripts/generate.js spark",
    "generate:postgres": "node scripts/generate.js postgres",
    "generate:mysql": "node scripts/generate.js mysql",
    "generate:snowflake": "node scripts/generate.js snowflake",
    "test:corpus:snowflake": "cd snowflake && npx tree-sitter test",
    "generate:bigquery": "node scripts/generate.js bigquery",
    "test:corpus:bigquery": "cd bigquery && npx tree-sitter test",
    "generate:mariadb": "node scripts/generate.js mariadb",
    "test:corpus:mariadb": "cd mariadb && npx tree-sitter test",
    "generate:sqlite": "node scripts/generate.js sqlite",
    "test:corpus:sqlite": "cd sqlite && npx tree-sitter test",
    "generate:hive": "node scripts/generate.js hive",
    "test:corpus:hive": "cd hive && npx tree-sitter test",
    "generate:oracle": "node scripts/generate.js oracle",
    "test:corpus:oracle": "cd oracle && npx tree-sitter test",
    "generate:db2": "node scripts/generate.js db2",
    "test:corpus:db2": "cd db2 && npx tree-sitter test",
    "generate:tsql": "node scripts/generate.js tsql",
    "test:corpus:tsql": "cd tsql && npx tree-sitter test",
    "generate:duckdb": "node scripts/generate.js duckdb",
    "test:corpus:duckdb": "cd duckdb && npx tree-sitter test",
    "generate:trino": "node scripts/generate.js trino",
    "test:corpus:trino": "cd trino && npx tree-sitter test",
    "generate:athena": "node scripts/generate.js athena",
    "test:corpus:athena": "cd athena && npx tree-sitter test",
    "generate:redshift": "node scripts/generate.js redshift",
    "test:corpus:redshift": "cd redshift && npx tree-sitter test",
    "generate:clickhouse": "node scripts/generate.js clickhouse",
    "test:corpus:clickhouse": "cd clickhouse && npx tree-sitter test",
    "generate:flink": "node scripts/generate.js flink",
    "test:corpus:flink": "cd flink && npx tree-sitter test",
    "generate:cockroachdb": "node scripts/generate.js cockroachdb",
    "test:corpus:cockroachdb": "cd cockroachdb && npx tree-sitter test",
    "generate:spanner": "node scripts/generate.js spanner",
    "test:corpus:spanner": "cd spanner && npx tree-sitter test",
    "generate:teradata": "node scripts/generate.js teradata",
    "generate:hana": "node scripts/generate.js hana",
    "test:corpus:hana": "cd hana && npx tree-sitter test",
    "test:corpus:teradata": "cd teradata && npx tree-sitter test",
    "generate:all": "node scripts/generate-all.js",
    "generate:force": "npx tree-sitter generate",
    "build": "npm run generate && node-gyp-build",
    "test:corpus": "npx tree-sitter test",
    "test:corpus:databricks": "cd databricks && npx tree-sitter test",
    "test:corpus:spark": "cd spark && npx tree-sitter test",
    "test:corpus:postgres": "cd postgres && npx tree-sitter test",
    "test:corpus:mysql": "cd mysql && npx tree-sitter test",
    "test:keywords": "bash scripts/test-keywords.sh",
    "coverage": "python tools/coverage.py",
    "bench": "python tools/parse_bench.py",
    "bench:check": "python tools/parse_bench.py --check",
    "coverage:setup": "pip install -r tools/requirements.txt && bash tools/antlr/setup.sh",
    "test:node": "node --test bindings/node/*_test.js",
    "test": "npm run test:corpus && npm run test:keywords && npm run test:node",
    "parse": "npx tree-sitter parse",
    "prestart": "npx tree-sitter build --wasm",
    "start": "npx tree-sitter playground",
    "release": "commit-and-tag-version",
    "prebuildify": "prebuildify --napi --strip",
    "docs:prep": "node scripts/docs-prep.js",
    "docs:dev": "npm run docs:prep && vitepress dev docs",
    "docs:build": "npm run docs:prep && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "author": "relativelyunknown",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "commit-and-tag-version": "^12.0.0",
    "node-gyp": "^12.0.0",
    "prebuildify": "^6.0.0",
    "tree-sitter-cli": "0.26.3",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  },
  "gypfile": true,
  "directories": {
    "test": "test"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relativelyunknown/tree-sitter-sql-extended.git"
  },
  "bugs": {
    "url": "https://github.com/relativelyunknown/tree-sitter-sql-extended/issues"
  },
  "homepage": "https://github.com/relativelyunknown/tree-sitter-sql-extended#readme",
  "commit-and-tag-version": {
    "skip": {
      "tag": true
    },
    "infile": "docs/changelog.md"
  },
  "keywords": [
    "parser",
    "sql"
  ],
  "files": [
    "grammar.js",
    "grammar/**",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "tree-sitter.json"
  ]
}
